{
  "expo": {
    "name": "MTeam",
    "slug": "mteam",
    "owner": "sadgobelas-team",
    "scheme": "mteam",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ge.mteam.app",
      "supportsTablet": true
    },
    "android": {
      "package": "ge.mteam.app",
      "adaptiveIcon": {
        "backgroundColor": "#986DC6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      ["expo-splash-screen", { "image": "./assets/splash-mark.png", "imageWidth": 96, "backgroundColor": "#986DC6", "dark": { "backgroundColor": "#141019" } }],
      ["expo-notifications", { "color": "#986DC6" }],
      ["expo-image-picker", { "photosPermission": "MTeam needs your photos to add them to your listing." }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://mteam-phi.vercel.app",
      "eas": { "projectId": "9a12e918-5725-4012-9a4e-e62c6e384e27" }
    }
  }
}
