DATABASE_URL="postgresql://mteam:mteam@localhost:5432/mteam"

# "console" prints login codes to the server log. Local testing only.
SMS_PROVIDER="console"

# Key for hashing login codes. This placeholder works locally; anywhere real, use the output of: openssl rand -hex 32
LOGIN_CODE_SECRET="replace-with-openssl-rand-hex-32"

# S3-compatible photo storage. These values match docker-compose.yml; Cloudflare R2 takes the same settings.
STORAGE_ENDPOINT="http://localhost:8333"
STORAGE_BUCKET="mteam-photos"
STORAGE_ACCESS_KEY_ID="mteam-local"
STORAGE_SECRET_ACCESS_KEY="mteam-local-secret"
STORAGE_PUBLIC_URL="http://localhost:8333/mteam-photos"

# The public address of the site, used in the sitemap and in links search engines see.
SITE_URL="http://localhost:3111"
