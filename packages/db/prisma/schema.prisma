// MTeam listings platform: first-version data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER   // owner or private person posting listings
  AGENT  // MTeam broker
  ADMIN  // moderation
}

enum DealType {
  SALE
  RENT
  DAILY
  PLEDGE
  LEASE
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  COUNTRY_HOUSE
  HOTEL
}

enum BuildingStatus {
  OLD
  NEW
  CONSTRUCTION
}

enum Currency {
  USD
  GEL
}

enum ListingStatus {
  DRAFT
  PENDING   // waiting for moderation
  ACTIVE
  ARCHIVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  SIGNED
  CLOSED
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique // login by SMS code
  name      String?
  email     String?
  role      Role      @default(USER)
  agent     Agent?
  listings  Listing[]
  favorites Favorite[]
  hidden    HiddenListing[]
  sessions  Session[]
  createdAt DateTime  @default(now())
}

// One pending SMS code per phone. Only a hash of the code is stored.
model LoginCode {
  phone     String   @id
  codeHash  String
  attempts  Int      @default(0)
  sentAt    DateTime
  expiresAt DateTime
}

// How many login codes an address has asked for in the current window. The address is stored only as a keyed hash.
model CodeRequestLimit {
  ipHash      String   @id
  count       Int
  windowStart DateTime
}

// Only a hash of the token is stored, so a database leak does not expose sessions.
model Session {
  tokenHash String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Branch {
  id     String  @id @default(cuid())
  name   String  // e.g. "Vake", "Batumi"
  city   String
  agents Agent[]
}

model Agent {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id])
  userId   String    @unique
  branch   Branch?   @relation(fields: [branchId], references: [id])
  branchId String?
  photoUrl String?
  listings Listing[] @relation("AgentListings")
  verifiedListings Listing[] @relation("VerifiedListings")
  leads    Lead[]
}

model Listing {
  id          Int           @id @default(autoincrement())
  sourceRef   String?       @unique // the listing's number in the file it was imported from, so a second run does not duplicate it
  status      ListingStatus @default(PENDING)
  deal        DealType
  type        PropertyType
  title       String
  description String
  city        String
  district    String?
  address     String?
  street      String?
  metro       String?
  building    BuildingStatus?
  lat         Float?
  lng         Float?
  price       Int
  pricePerSqmUsd Int
  priceUsd    Int           // price at fixed rates, so mixed currencies can be filtered and sorted
  currency    Currency      @default(USD)
  area        Float         // m²
  rooms       Int?
  floor       Int?
  floors      Int?
  condition   String?
  projectType String?
  bathroom    String?
  storage     String?
  parking     String?
  heating     String?
  hotWater    String?
  material    String?
  windows     String?
  livingRoom  String?
  bedrooms    Int?
  ceiling     Float?
  yearBuilt   Int?
  features    String[]      @default([])
  verified    Boolean       @default(false) // checked on site by an MTeam broker
  verifiedAt  DateTime?
  verifiedBy  Agent?        @relation("VerifiedListings", fields: [verifiedById], references: [id])
  verifiedById String?
  owner       User          @relation(fields: [ownerId], references: [id])
  ownerId     String
  agent       Agent?        @relation("AgentListings", fields: [agentId], references: [id])
  agentId     String?
  images      ListingImage[]
  favorites   Favorite[]
  hiddenBy    HiddenListing[]
  reports     ListingReport[]
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, deal, city])
  @@index([priceUsd])
}

model ListingImage {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  url       String
  position  Int     @default(0)
}

model HiddenListing {
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model ListingReport {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  reason    String
  note      String?
  ipHash    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([listingId, ipHash])
}

model Favorite {
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// "Give it to MTeam": an owner asks MTeam to sell or rent their property.
model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  deal      DealType
  city      String?
  note      String?
  status    LeadStatus @default(NEW)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  agentId   String?
  createdAt DateTime   @default(now())
}
