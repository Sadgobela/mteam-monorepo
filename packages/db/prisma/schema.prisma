// MTeam listings platform: first-version data model.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// What brought someone here, asked once at onboarding to shape their account.
enum UserIntent {
  SEEKING // looking to buy or rent
  OWNER // has a property to sell or rent out
  BROKER // works as a broker
}

enum NotificationType {
  MESSAGE // a new chat message
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_EXPIRING // an owner's listing ends in a few days
  PRICE_DROP // a favourite got cheaper
  SEARCH_MATCHES // new listings for a saved search
}

enum EmailTokenPurpose {
  VERIFY // confirms the address belongs to the user
  RESET // sets a new password
}

enum Role {
  USER // owner or private person posting listings
  AGENT // MTeam broker
  ADMIN // moderation
}

enum DealType {
  SALE
  RENT
  DAILY
  PLEDGE
  LEASE
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  COUNTRY_HOUSE
  HOTEL
}

enum BuildingStatus {
  OLD
  NEW
  CONSTRUCTION
}

enum Currency {
  USD
  GEL
}

enum ListingStatus {
  DRAFT
  PENDING // waiting for moderation
  ACTIVE
  ARCHIVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  SIGNED
  CLOSED
}

model User {
  id                   String             @id @default(cuid())
  phone                String?            @unique // login by SMS code; empty after Google, Facebook or Apple until one is added
  name                 String?
  email                String?            @unique // sign-in by email and password; never filled from Google, Facebook or Apple
  emailVerifiedAt      DateTime?
  passwordHash         String? // scrypt, see db/src/password.ts; empty for phone and social accounts
  avatarUrl            String?
  intent               UserIntent?
  onboardedAt          DateTime? // set when the first-visit questions are answered
  deletedAt            DateTime? // set when the user deleted their account; such a user can never sign in again
  termsAcceptedAt      DateTime?
  // What the user wants to hear about. In-app now; email and SMS follow these once a provider is in.
  notifyMessages       Boolean            @default(true)
  notifySavedSearches  Boolean            @default(true)
  notifyPriceDrops     Boolean            @default(true)
  notifyListingUpdates Boolean            @default(true)
  hidePhoneDefault     Boolean            @default(false) // new listings start with the number hidden, chat only
  notifyPush           Boolean            @default(true) // push notifications on every device the user turned them on for
  pushSubscriptions    PushSubscription[]
  appPushTokens        AppPushToken[]
  notifications        Notification[]
  emailTokens          EmailToken[]
  invitesSent          AgentInvite[]      @relation("InviteCreator")
  invitesUsed          AgentInvite[]      @relation("InviteUser")
  role                 Role               @default(USER)
  agent                Agent?
  listings             Listing[]
  favorites            Favorite[]
  hidden               HiddenListing[]
  savedSearches        SavedSearch[]
  buying               Conversation[]     @relation("Buyer")
  selling              Conversation[]     @relation("Seller")
  messages             Message[]
  sessions             Session[]
  identities           Identity[]
  createdAt            DateTime           @default(now())
}

enum IdentityProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

// An account at Google, Facebook or Apple that signs in as this user. The subject is that provider's stable user id.
model Identity {
  provider  IdentityProvider
  subject   String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime         @default(now())

  @@id([provider, subject])
  @@index([userId])
}

// One pending SMS code per phone. Only a hash of the code is stored.
model LoginCode {
  phone     String   @id
  codeHash  String
  attempts  Int      @default(0)
  sentAt    DateTime
  expiresAt DateTime
}

// How many login codes an address has asked for in the current window. The address is stored only as a keyed hash.
model CodeRequestLimit {
  ipHash      String   @id
  count       Int
  windowStart DateTime
}

// Only a hash of the token is stored, so a database leak does not expose sessions.
model Session {
  tokenHash  String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  expiresAt  DateTime
  userAgent  String? // shown in settings, so a user can tell their devices apart
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One-time link sent by email. Only a hash of the token is stored.
model EmailToken {
  tokenHash String            @id
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  purpose   EmailTokenPurpose
  email     String // the address the link was sent to
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
}

model Branch {
  id      String        @id @default(cuid())
  name    String // e.g. "Vake", "Batumi"
  city    String
  agents  Agent[]
  invites AgentInvite[]
}

model Agent {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String    @unique
  branch           Branch?   @relation(fields: [branchId], references: [id])
  branchId         String?
  photoUrl         String?
  bio              String?
  listings         Listing[] @relation("AgentListings")
  verifiedListings Listing[] @relation("VerifiedListings")
  leads            Lead[]
}

model Listing {
  id             Int                  @id @default(autoincrement())
  sourceRef      String?              @unique // the listing's number in the file it was imported from, so a second run does not duplicate it
  status         ListingStatus        @default(PENDING)
  deal           DealType
  type           PropertyType
  title          String
  description    String
  city           String
  district       String?
  address        String?
  street         String?
  metro          String?
  building       BuildingStatus?
  lat            Float?
  lng            Float?
  price          Int
  pricePerSqmUsd Int
  marketLevel    Int? // 1 (well below market) to 5, see market.ts; empty while there are too few comparable listings
  priceUsd       Int // price in dollars at the stored daily rate, so mixed currencies can be filtered and sorted
  currency       Currency             @default(USD)
  area           Float // m²
  rooms          Int?
  floor          Int?
  floors         Int?
  condition      String?
  projectType    String?
  bathroom       String?
  storage        String?
  parking        String?
  heating        String?
  hotWater       String?
  material       String?
  windows        String?
  livingRoom     String?
  bedrooms       Int?
  ceiling        Float?
  yearBuilt      Int?
  features       String[]             @default([])
  verified       Boolean              @default(false) // checked on site by an MTeam broker
  verifiedAt     DateTime?
  verifiedBy     Agent?               @relation("VerifiedListings", fields: [verifiedById], references: [id])
  verifiedById   String?
  owner          User                 @relation(fields: [ownerId], references: [id])
  ownerId        String
  agent          Agent?               @relation("AgentListings", fields: [agentId], references: [id])
  agentId        String?
  images         ListingImage[]
  favorites      Favorite[]
  hiddenBy       HiddenListing[]
  conversations  Conversation[]
  reports        ListingReport[]
  views          Int                  @default(0)
  phoneReveals   Int                  @default(0)
  hidePhone      Boolean              @default(false) // buyers can only write through chat
  cadastralCode  String? // kept for MTeam, never shown on the site
  descriptionEn  String?
  descriptionRu  String?
  expiresAt      DateTime? // owners' listings end after 60 days unless renewed; brokers' never do
  bumpedAt       DateTime? // a free bump once a day moves the listing up in "newest"
  priceChanges   ListingPriceChange[]
  notifications  Notification[]
  leads          Lead[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, deal, city])
  @@index([priceUsd])
}

model ListingImage {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  url       String
  position  Int     @default(0)

  @@index([listingId])
}

model HiddenListing {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model ListingReport {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  reason    String
  note      String?
  ipHash    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([listingId, ipHash])
}

model Conversation {
  id            String    @id @default(cuid())
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     Int
  buyer         User      @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId       String
  seller        User      @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId      String
  buyerReadAt   DateTime?
  sellerReadAt  DateTime?
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  query     String // the search's URL parameters, in canonicalSearch form
  seenAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, query])
}

model Favorite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// "Give it to MTeam": an owner asks MTeam to sell or rent their property.
model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  deal      DealType
  city      String?
  note      String?
  /// Set when someone looking for a property asked a broker to find it: their search's URL parameters.
  search    String?
  /// Set when an owner asked MTeam to verify one of their listings on site.
  listing   Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId Int?
  status    LeadStatus @default(NEW)
  agent     Agent?     @relation(fields: [agentId], references: [id])
  agentId   String?
  createdAt DateTime   @default(now())

  @@index([listingId, createdAt])
}

// The National Bank of Georgia's official rate, lari per one unit of the currency. Refreshed nightly; see rates.ts.
model ExchangeRate {
  currency   String   @id
  gelPerUnit Float
  validFrom  DateTime
}

// What a user is told about, newest first. Data holds what the text needs, such as an old and new price.
model Notification {
  id             String           @id @default(cuid())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  type           NotificationType
  listing        Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId      Int?
  conversationId String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// A browser that agreed to receive push notifications for this user. The keys encrypt each message for that browser only.
model PushSubscription {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  endpoint   String   @unique // the push service's address for this browser
  p256dh     String
  auth       String
  userAgent  String?
  locale     String   @default("ka") // the language of the page that subscribed, used for the message text
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// A phone with the mobile app that turned push on: its Expo push token, sent through Expo's push service.
model AppPushToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  token      String   @unique // ExponentPushToken[...]
  platform   String // ios or android
  locale     String   @default("ka") // the app's language when push was turned on, used for the message text
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// A published listing's price change, in dollars, for price-drop alerts and price history.
model ListingPriceChange {
  id          String   @id @default(cuid())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   Int
  oldPriceUsd Int
  newPriceUsd Int
  createdAt   DateTime @default(now())

  @@index([listingId, createdAt])
}

// A link the admin gives a broker. Signing in through it makes the user a broker, in the branch if one is set.
model AgentInvite {
  tokenHash   String    @id
  branch      Branch?   @relation(fields: [branchId], references: [id])
  branchId    String?
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  createdById String
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id])
  usedById    String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}
