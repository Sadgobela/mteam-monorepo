{
  "name": "@mteam/db",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:promote": "node --env-file-if-exists=.env prisma/promote.ts",
    "db:import": "tsx --env-file-if-exists=.env prisma/import.ts",
    "db:market": "tsx --env-file-if-exists=.env prisma/market.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "^6.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@mteam/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "zod": "^4.6.7"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  }
}
